<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>pl.bulka.dynamicnotch.agent</string>
    <key>BundleProgram</key>
    <string>Contents/MacOS/DynamicNotch</string>
    <key>RunAtLoad</key>
    <true/>
    <!-- Restart tylko po awarii; zwykłe „Zakończ” (kod 0) nie uruchamia programu ponownie -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>
    <key>ProcessType</key>
    <string>Interactive</string>
</dict>
</plist>
